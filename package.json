{
  "name": "ai-interview-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio-grade AI Interview Coach with real-time feedback",
  "scripts": {
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:backend": "cd backend && .venv/Scripts/uvicorn app.main:app --reload --port 8000",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .venv/Scripts/pytest -v",
    "test:frontend": "cd frontend && pnpm test",
    "build:frontend": "cd frontend && pnpm run build"
  }
}
