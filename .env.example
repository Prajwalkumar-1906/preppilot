# ========================================================
# AI Interview Coach - Environment Configuration
# ========================================================

# Project & Security
PROJECT_NAME="AI Interview Coach"
SECRET_KEY="supersecret-interview-coach-jwt-token-key-2026-production-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Default for zero-setup local dev & tests is SQLite:
DATABASE_URL="sqlite:///./interview_coach.db"
SYNC_DATABASE_URL="sqlite:///./interview_coach.db"

# PostgreSQL (Docker or production):
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/interview_coach"
# SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_coach"

# LLM Provider Abstraction
# Options: "gemini", "openai", "mock" (default: "mock" for zero-cost testing)
LLM_PROVIDER="mock"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI or OpenAI-Compatible (Ollama, Groq, DeepSeek, OpenRouter)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# Speech-to-Text (faster-whisper)
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
AUDIO_UPLOAD_DIR="./storage/audio"
AUDIO_RETENTION_HOURS=0

# Frontend URL for CORS
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
